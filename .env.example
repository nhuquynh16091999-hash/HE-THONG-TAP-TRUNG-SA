# ═══════════════════════════════════════════════════════════════════════
# TALPHA — mẫu cấu hình môi trường (nhánh Python: sync POS + Meta → BigQuery)
# Copy sang .env rồi điền. KHÔNG commit .env có giá trị thật.
# Phần dashboard có file riêng: dashboard-ui/.env.example
# ═══════════════════════════════════════════════════════════════════════

# ─── BigQuery ───
GOOGLE_APPLICATION_CREDENTIALS=bigquery_key.json
BQ_PROJECT_ID=cty-507710
BQ_DATASET=TALPHA_Dataset
BQ_LOCATION=US

# ─── Meta Ads — app "Talpha Post" ───
TALPHA_META_APP_ID=
TALPHA_META_APP_SECRET=
TALPHA_META_ACCESS_TOKEN=

# ─── Poscake POS — MỘT shop: Đài Loan (shop_id 1328343252) ───
# Hệ thống từ 05/09/2026 chỉ còn thị trường Đài Loan. Thêm thị trường mới thì
# phải khai cả ở config/talpha_rules.json → markets, nếu không tiền sẽ quy sai
# tỷ giá mà không có cảnh báo nào.
POSCAKE_API_URL=https://pos.pages.fm/api/v1
TALPHA_POSCAKE_TW_KEY=
TALPHA_PANCAKE_API_TOKEN=

# ─── Chạy ───
ENV=dev
LOG_LEVEL=INFO

# ─── Deploy lên máy chủ (ops/deploy/from-mac.sh) ───
# Script đọc thẳng các biến này, hoặc dùng mặc định của nó.
HOST=139.180.131.21
KEY=~/.ssh/id_ed25519_talpha_vps
GH_KEY=~/.ssh/id_ed25519_hethong
APP_DIR=/opt/talpha
