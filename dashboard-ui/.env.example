# ═══════════════════════════════════════════════════════════════════════
# TALPHA Dashboard — mẫu cấu hình. Copy sang .env.local rồi điền.
# ═══════════════════════════════════════════════════════════════════════

# ─── BigQuery ───
NEXT_PUBLIC_BQ_PROJECT=talpha-faos-2026
DATASET=TALPHA_Dataset
NEXT_PUBLIC_DATASET=TALPHA_Dataset
# Service account đọc BigQuery. Chọn MỘT: dán JSON một dòng vào đây,
# hoặc để file bigquery_key.json ở gốc repo rồi bỏ trống dòng này.
GCP_SA_KEY_JSON=

# ─── Deployment ───
NEXT_PUBLIC_DEPLOYMENT_MODE=talpha
NEXT_PUBLIC_APP_NAME=TALPHA

# ─── Đăng nhập (NextAuth v5) ───
# AUTH_SECRET sinh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
USERS_JSON=../config/users.json

# ─── Meta Ads — cần cho tab Chi phí quảng cáo và Ads Command Center ───
TALPHA_META_ACCESS_TOKEN=
TALPHA_META_APP_SECRET=

# ─── Poscake POS Đài Loan — cần cho tab Sản phẩm & Kho ───
TALPHA_POSCAKE_TW_KEY=
TALPHA_PANCAKE_API_TOKEN=

# ─── Tuỳ chọn ───
# DASHBOARD_API_KEY=   # bật thì /api/query bắt buộc có x-api-key
# TALPHA_SYNC_TOKEN=   # token cho job snapshot gọi vào
# GEMINI_API_KEY=      # cho tính năng "CEO hỏi"
