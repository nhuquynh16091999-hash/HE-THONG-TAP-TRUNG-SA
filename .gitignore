# ═══ Bí mật — KHÔNG BAO GIỜ commit ═══
.env
.env.*
!.env.example
*.env
bigquery_key.json
bigquery_key_*.json
*-service-account*.json
credentials.json
token.json
*.pem
*.key

# ═══ Dữ liệu người dùng nhập trên dashboard (sao kê 3PL, số tiền thật) ═══
# Gạch chéo đầu = CHỈ thư mục data/ ở gốc repo. Viết "data/" trần thì git bỏ qua
# mọi thư mục tên data ở mọi tầng — kể cả
# dashboard-ui/src/components/talpha/data/ vốn là mã nguồn.
/data/

# Bản lưu kho dữ liệu hạ từ máy chủ về (ops/deploy/from-mac.sh) — cũng là số thật
/data-backup-*/

# ═══ Bảng tra nhập tay (giá vốn, combo, tỷ giá) — có số tiền thật ═══
/config/manual_data/

# ═══ Node ═══
node_modules/
.next/
.test-build/
*.tsbuildinfo

# ═══ Python ═══
__pycache__/
*.pyc
*.pyo
.venv/
.venv-test/

# ═══ Log & tạm ═══
*.log
logs/
.tmp/
*.bak_*
.DS_Store
Thumbs.db

# ═══ IDE / công cụ ═══
.vscode/
.idea/
*.swp
.vercel/
.worktrees

