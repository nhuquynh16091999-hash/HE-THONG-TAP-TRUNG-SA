<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- C2 — snapshot tồn kho mỗi 15'. Nguồn dự phòng của tab Kho khi POS Poscake chết,
     nên phải luôn tươi (trước C2 bảng đứng im từ 10/07).
     Rẻ: ~4s/lượt, không đụng Meta API.
     RunAtLoad: máy ngủ/tắt qua đêm → bật lên có snapshot mới ngay, không chờ 15'.
     Deploy: cp vào ~/Library/LaunchAgents/ rồi launchctl unload+load. -->
<dict>
    <key>Label</key><string>com.talpha.snapshot-inventory</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/syanh/talpha_reports/snapshot_cron.sh</string>
        <string>inventory</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>StartInterval</key><integer>900</integer>
    <key>StandardOutPath</key><string>/Users/syanh/talpha_reports/snapshot_launchd.log</string>
    <key>StandardErrorPath</key><string>/Users/syanh/talpha_reports/snapshot_launchd.log</string>
</dict>
</plist>
