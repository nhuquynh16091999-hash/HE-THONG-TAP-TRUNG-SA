<?xml version="1.0" encoding="UTF-8"?>
<!--
  Khởi động lại pm2 sau khi máy bật lại.

  Cố ý KHÔNG dùng `pm2 startup`: lệnh đó cần mật khẩu quản trị và cài vào launchd
  cấp hệ thống. LaunchAgent của người dùng thì không cần quyền gì.

  ⚠️ Nếu dự án nằm trong ~/Desktop, ~/Documents hay ~/Downloads thì macOS chặn
  tiến trình do launchd khởi động đọc thư mục đó (lỗi EPERM), pm2 sẽ dựng lên rồi
  chết ngay. Cách chắc ăn: chuyển dự án ra chỗ không bị bảo vệ, ví dụ ~/talpha.
  Xem docs/DEPLOY_MACBOOK.md.

  Cài:
    cp ops/launchd/com.talpha.pm2-resurrect.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.talpha.pm2-resurrect.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.talpha.pm2-resurrect</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>export PATH="$HOME/.nvm/versions/node/v24.14.0/bin:/opt/homebrew/bin:$PATH"; pm2 resurrect</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/talpha-pm2-resurrect.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/talpha-pm2-resurrect.err</string>
</dict>
</plist>
